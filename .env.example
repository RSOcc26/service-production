# Configuration for service-production.
# Copy to .env for local development. Never commit .env.
# Every value below is a placeholder; real credentials come from Kubernetes
# Secrets or your local .env only.

# HTTP
PORT=3005
LOG_LEVEL=info

# PostgreSQL: this service's own database (ADR-0001).
# Runtime role: DML only, not the table owner, no BYPASSRLS.
DATABASE_URL=postgres://production_app:change-me@localhost:5432/production
# Migration role: owns the schema; used only when applying migrations.
DATABASE_MIGRATION_URL=postgres://production_migrator:change-me@localhost:5432/production

# Apache Kafka. The local broker has no authentication; in Kubernetes each
# service has its own SCRAM user restricted by ACLs.
KAFKA_BROKERS=localhost:9094
KAFKA_CLIENT_ID=service-production
KAFKA_TOPIC=production.events
KAFKA_GROUP_ID=production
KAFKA_CONSUME_TOPICS=inventory.events,workflow.events
KAFKA_DLT_TOPIC=production.dlt
KAFKA_SASL_MECHANISM=
KAFKA_USERNAME=
KAFKA_PASSWORD=

# Tenant context signed by the gateway (ADR-0001)
TENANT_CONTEXT_JWKS_URL=http://localhost:8080/.well-known/jwks.json
TENANT_CONTEXT_ISSUER=companycentral-gateway
TENANT_CONTEXT_AUDIENCE=service-production

# Services this one calls (local URLs; cluster-internal URLs in Kubernetes)
INVENTORY_URL=http://localhost:3004
